# ─── GROQ ───────────────────────────────────────────
GROQ_API_KEY=gsk_COLE_SUA_CHAVE_AQUI
GROQ_MODEL=llama-3.3-70b-versatile

# ─── EVOLUTION API ──────────────────────────────────
EVOLUTION_HOST=http://IP_DA_VPS:PORTA
EVOLUTION_API_KEY=SUA_API_KEY
EVOLUTION_INSTANCE=nome-da-instancia

# ─── NÚMERO DO ATENDENTE ────────────────────────────
# Formato: 5581999999999 (DDI + DDD + número, sem espaços)
ATENDENTE_NUMBER=55DDNNNNNNNNN

# ─── SEGURANÇA ──────────────────────────────────────
WEBHOOK_SECRET=topphone2026

# ─── ADMIN PANEL (porta 9000) ───────────────────────
ADMIN_PASSWORD=SUA_SENHA_AQUI
ADMIN_SECRET=chave-aleatoria-longa-para-sessao
# IP público da sua VPS — usado para montar a URL do webhook ao criar clientes
VPS_HOST=SEU_IP_DA_VPS

# ─── LOJA (semente inicial — editável pelo painel /config) ──
STORE_NAME=Nome da Loja
STORE_ADDRESS=Rua Exemplo, 123 — Bairro, Cidade-UF
SESSION_TIMEOUT=30
CONVERSATION_TONE=informal
